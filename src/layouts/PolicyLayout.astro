---
// Shared shell for the AI Ads Lab policy pages (privacy, terms, data deletion).
// Meta requires these URLs in the app's Basic Settings before App Review.
// Styles match ig-growth-privacy.astro.
interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}
const { title, description, path, updated } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="canonical" href={`https://hmficmarketing.com${path}`} />
  <title>{title} | AI Ads Lab</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex,follow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #1a1a1a;
      --muted: #555;
      --bg: #fafafa;
      --accent: #c8a84b;
    }
    * { box-sizing: border-box; }
    body {
      font-family: 'DM Sans', -apple-system, system-ui, sans-serif;
      color: var(--ink);
      background: var(--bg);
      line-height: 1.65;
      margin: 0;
      padding: 48px 24px;
    }
    main {
      max-width: 720px;
      margin: 0 auto;
      background: white;
      padding: 48px 56px;
      border-radius: 8px;
      box-shadow: 0 2px 16px rgba(0,0,0,0.06);
    }
    h1 {
      font-size: 32px;
      margin: 0 0 8px;
      letter-spacing: -0.02em;
    }
    h2 {
      font-size: 20px;
      margin: 36px 0 12px;
      letter-spacing: -0.01em;
    }
    .meta {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 32px;
      padding-bottom: 24px;
      border-bottom: 1px solid #eee;
    }
    p, li { font-size: 16px; color: var(--ink); }
    li { margin-bottom: 6px; }
    a { color: var(--accent); }
    nav.policies {
      margin-top: 40px;
      font-size: 14px;
      color: var(--muted);
    }
    nav.policies a { margin-right: 16px; }
    .contact {
      margin-top: 40px;
      padding: 20px 24px;
      background: #f5f2e8;
      border-left: 3px solid var(--accent);
      border-radius: 4px;
      font-size: 15px;
    }
    @media (max-width: 640px) {
      body { padding: 24px 12px; }
      main { padding: 32px 24px; }
      h1 { font-size: 26px; }
    }
  </style>
</head>
<body>
  <main>
    <h1>{title}</h1>
    <p class="meta">Last updated: {updated}</p>
    <slot />
    <div class="contact">
      <strong>Contact</strong><br />
      Privacy questions, deletion requests, or anything about these policies:<br />
      <a href="mailto:matt@hmficmarketing.com">matt@hmficmarketing.com</a><br />
      HMFIC Marketing LLC
    </div>
    <nav class="policies">
      <a href="/ai-ads-lab/privacy">Privacy Policy</a>
      <a href="/ai-ads-lab/terms">Terms of Service</a>
      <a href="/ai-ads-lab/data-deletion">Data Deletion</a>
    </nav>
  </main>
</body>
</html>
